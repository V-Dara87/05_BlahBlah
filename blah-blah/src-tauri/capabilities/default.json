{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for the editor window: app-owned files, validated sidecars and vscode/cursor deep links.",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
