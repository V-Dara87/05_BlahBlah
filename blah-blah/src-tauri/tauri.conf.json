{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "blahblah",
  "version": "0.1.0",
  "identifier": "com.blahblah.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "blahblah",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost https:",
        "media-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data: https:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost data: blob: https://esm.sh https://*.esm.sh https://huggingface.co https://*.huggingface.co https://hf.co https://*.hf.co http://localhost:5173 ws://localhost:5173",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/esbuild.wasm": "esbuild.wasm"
    },
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/whisper-cli"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
