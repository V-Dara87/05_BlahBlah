{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "blahblah",
  "version": "0.1.0",
  "identifier": "com.blahblah.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "blahblah",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../public/esbuild.wasm": "esbuild.wasm"
    },
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
