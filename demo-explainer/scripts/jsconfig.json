{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react",
    "allowJs": true,
    "checkJs": true,
    "baseUrl": ".",
    "paths": {
      "@blahblah/sdk": [
        "./.blahblah/sdk"
      ]
    },
    "noImplicitAny": false,
    "strictNullChecks": false
  },
  "include": [
    "**/*",
    ".blahblah/**/*"
  ]
}